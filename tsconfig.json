{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.mjs",
    "next.config.ts",
    "vitest.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "next.config.test.ts",
    ".next-verify-3283/types/**/*.ts",
    ".next-verify-3283/dev/types/**/*.ts",
    ".next-verify-3284/types/**/*.ts",
    ".next-verify-3284/dev/types/**/*.ts",
    ".next-verify-3285/types/**/*.ts",
    ".next-verify-3285/dev/types/**/*.ts",
    ".next-verify-3287/types/**/*.ts",
    ".next-verify-3287/dev/types/**/*.ts",
    ".next-verify-3288/types/**/*.ts",
    ".next-verify-3288/dev/types/**/*.ts",
    ".next-verify-cbz-final-20260918/types/**/*.ts",
    ".next-verify-cbz-final-20260918/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".verify-*",
    ".next-*"
  ]
}
