{
    "name": "judu-reader",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "test": "vitest run --exclude \".verify-*/**\"",
        "build:mobi-worker": "node scripts/build-mobi-worker.mjs",
        "predev": "npm run build:mobi-worker && npm run build:umd-worker",
        "prebuild": "npm run build:mobi-worker && npm run build:umd-worker",
        "pretest": "npm run build:mobi-worker && npm run build:umd-worker",
        "test:epub-worker": "node --test scripts/epub/foliate-import-worker.test.mjs",
        "build:umd-worker": "node scripts/build-umd-worker.mjs",
        "build:release": "node scripts/build-release.mjs",
        "package:release": "node scripts/package-release.mjs",
        "verify:release": "node scripts/smoke-release.mjs",
        "test:release": "node --test scripts/release-manifest.test.mjs scripts/release-traces.test.mjs scripts/package-release.test.mjs scripts/build-release.test.mjs scripts/smoke-release.test.mjs scripts/start-release.test.mjs",
        "desktop:dev": "node desktop/launch.mjs",
        "test:desktop": "node scripts/build-desktop-guard.mjs && node --test desktop/*.test.mjs",
        "check:desktop": "tsc --project desktop/tsconfig.json",
        "build:desktop": "node scripts/build-desktop.mjs",
        "verify:desktop-install": "node scripts/smoke-desktop-install.mjs"
    },
    "dependencies": {
        "@langchain/anthropic": "^1.5.10",
        "@langchain/core": "^1.2.11",
        "@langchain/openai": "^1.5.13",
        "@noble/hashes": "2.0.1",
        "entities": "8.1.0",
        "epub": "^2.1.1",
        "fast-xml-parser": "5.11.1",
        "jsdom": "^30.0.1",
        "jszip": "3.10.2",
        "langchain": "^1.5.11",
        "next": "16.3.5",
        "parse5": "8.0.1",
        "pdf-parse": "^2.4.5",
        "pdfjs-dist": "5.4.296",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "sharp": "0.35.4",
        "simple-mind-map": "0.14.0-fix.3",
        "unified": "^11.0.5",
        "unist-util-visit": "^5.1.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@lingo-reader/mobi-parser": "0.4.6",
        "@tailwindcss/postcss": "^4",
        "@types/jsdom": "30.0.0",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "electron": "45.0.0",
        "electron-builder": "26.18.0",
        "esbuild": "0.28.2",
        "eslint": "^9",
        "eslint-config-next": "16.3.5",
        "tailwindcss": "^4",
        "typescript": "^5",
        "vitest": "^3.2.4"
    },
    "overrides": {
        "simple-mind-map": {
            "uuid": "11.1.1"
        }
    }
}
