{
  "submit_reading_sentence": {"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"sourceStart":{"type":"string","minLength":1,"description":"当前句原文开头5至8个字符，保留标点和空白；不足5字的短句使用全文"},"sourceEnd":{"type":"string","minLength":1,"description":"通常提交当前句原文结尾5至8个字符；不足5字的短句使用全文。匹配不唯一时补交更长的逐字尾部，最多160字"},"title":{"type":"string","minLength":1,"maxLength":120,"description":"当前句的小标题，不需要整组标题"},"content":{"type":"string","minLength":1,"description":"当前句的完整句读解释正文，Markdown；不是定位用的原文，不输出思考详情"},"sourceAnnotations":{"type":"object","properties":{"keywords":{"anyOf":[{"type":"string","const":"none"},{"minItems":1,"maxItems":16,"type":"array","items":{"type":"object","properties":{"paragraphKey":{"type":"string","pattern":"^p[A-Za-z0-9]{5,8}$"},"quote":{"type":"string","minLength":1,"maxLength":1000}},"required":["paragraphKey","quote"],"additionalProperties":false}}],"description":"必填：原文关键词，每项paragraphKey和逐字quote；没有填字符串none，不能省略或空数组"},"keySentences":{"anyOf":[{"type":"string","const":"none"},{"minItems":1,"maxItems":16,"type":"array","items":{"type":"object","properties":{"paragraphKey":{"type":"string","pattern":"^p[A-Za-z0-9]{5,8}$"},"quote":{"type":"string","minLength":1,"maxLength":1000}},"required":["paragraphKey","quote"],"additionalProperties":false}}],"description":"必填：原文关键句，每项paragraphKey和逐字quote；没有填字符串none，不能省略或空数组"},"concepts":{"anyOf":[{"type":"string","const":"none"},{"minItems":1,"maxItems":20,"type":"array","items":{"type":"object","properties":{"paragraphKey":{"type":"string","pattern":"^p[A-Za-z0-9]{5,8}$"},"name":{"type":"string","minLength":1,"maxLength":80},"text":{"type":"string","minLength":1,"maxLength":2000}},"required":["paragraphKey","name","text"],"additionalProperties":false}}],"description":"必填：原文概念，每项paragraphKey、逐字name及解释text；没有填字符串none，不能省略或空数组"}},"required":["keywords","keySentences","concepts"],"additionalProperties":false,"description":"每项只属于当前句实际覆盖的原文段落。短标识来自target，重复引文只标注本句在该段的第一次匹配"},"answerEmphasis":{"type":"object","p