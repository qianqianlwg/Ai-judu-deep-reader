  "update_reading_guide": {"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"reason":{"type":"string","minLength":1,"maxLength":600},"upserts":{"maxItems":200,"type":"array","items":{"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":160},"parentId":{"anyOf":[{"type":"string","minLength":1,"maxLength":160},{"type":"null"}]},"title":{"type":"string","minLength":1,"maxLength":160},"summary":{"type":"string","description":"主题摘要20–100字，忠实概括主Agent分析；不要重复标题，不加无依据的解释"},"position":{"type":"object","properties":{"x":{"type":"number","minimum":-1000000,"maximum":1000000},"y":{"type":"number","minimum":-1000000,"maximum":1000000}},"required":["x","y"],"additionalProperties":false},"sourceIds":{"minItems":1,"maxItems":5,"type":"array","items":{"type":"string","minLength":1,"maxLength":160},"description":"仅引用输入中的句读块ID或已有节点依据ID，最多5个；不是原文段落ID"}},"required":["id","parentId","title","summary","sourceIds"],"additionalProperties":false}},"removeIds":{"maxItems":200,"type":"array","items":{"type":"string","minLength":1,"maxLength":160}}},"required":["reason","upserts","removeIds"],"additionalProperties":false},
