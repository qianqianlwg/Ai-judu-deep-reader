  "search_book": {"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"query":{"type":"string","minLength":1,"maxLength":500,"description":"主要检索问题或精确关键词；自然语言适合语义检索"},"additionalQueries":{"description":"最多两个补充关键词或改写，与主查询并行检索；避免无意义重复","maxItems":2,"type":"array","items":{"type":"string","minLength":1,"maxLength":500}},"mode":{"description":"默认 auto：索引可用时并行关键词与语义；精确引文用 keyword，语义问题用 auto","type":"string","enum":["auto","keyword","semantic","hybrid"]},"chapterId":{"default":null,"description":"可选章节过滤；null 表示全书","type":["string","null"]},"limit":{"default":5,"type":"integer","minimum":1,"maximum":8}},"required":["query","chapterId","limit"],"additionalProperties":false},
  "read_source": {"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"sourceId":{"type":"string","minLength":1,"maxLength":240},"neighbors":{"default":1,"type":"integer","minimum":0,"maximum":2}},"required":["sourceId","neighbors"],"additionalProperties":false},
